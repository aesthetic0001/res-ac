#!/bin/sh /etc/rc.common
START=95
STOP=10

start() {
    umask 077
    test -f /etc/res-ac/agent.json || return 0
    # Reuse the legacy TLS archive's flash slot for the persistent helper.
    test -f /usr/lib/res-ac/curl.gz || return 1
    gzip -dc /usr/lib/res-ac/curl.gz > /tmp/res-ac-http.new || return 1
    chmod 700 /tmp/res-ac-http.new
    mv /tmp/res-ac-http.new /tmp/res-ac-http
    /tmp/res-ac-http --version | grep -q '^res-ac-http protocol=1 ' || return 1
    start-stop-daemon -S -b -m -p /var/run/res-ac-agent.pid -x /usr/bin/python -- -u /usr/lib/res-ac/service_supervisor.py agent
}
stop() {
    start-stop-daemon -K -p /var/run/res-ac-agent.pid
    # Let the supervisor terminate its entire child process group before a
    # restart can create another agent. Manual stop never schedules a respawn.
    local attempts=0
    while test -f /var/run/res-ac-agent.pid && kill -0 "$(cat /var/run/res-ac-agent.pid)" 2>/dev/null; do
        attempts=$((attempts + 1))
        test "$attempts" -le 12 || return 1
        sleep 1
    done
    rm -f /var/run/res-ac-agent.pid
}
