#!/bin/sh /etc/rc.common
START=95
STOP=10

start() {
    umask 077
    test -f /etc/res-ac/agent.json || return 0
    # Reuse the legacy TLS archive's flash slot for the persistent helper.
    test -f /usr/lib/res-ac/curl.gz || return 1
    gzip -dc /usr/lib/res-ac/curl.gz > /tmp/res-ac-http.new || return 1
    chmod 700 /tmp/res-ac-http.new
    mv /tmp/res-ac-http.new /tmp/res-ac-http
    /tmp/res-ac-http --version | grep -q '^res-ac-http protocol=1 ' || return 1
    start-stop-daemon -S -b -m -p /var/run/res-ac-agent.pid -x /usr/bin/python -- -u /usr/lib/res-ac/res_ac_agent.py >> /tmp/res-ac-agent.log 2>&1
}
stop() {
    start-stop-daemon -K -p /var/run/res-ac-agent.pid
}
